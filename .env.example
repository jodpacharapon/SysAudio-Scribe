# Development-only fallback. In the packaged app the key is entered in Settings
# and stored encrypted via Electron safeStorage, never in a file like this.
# Only the variable matching the selected provider is read.
OPENAI_API_KEY=sk-your-key-here
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Only needed if you use the Gemini polish pass.
GEMINI_API_KEY=your-gemini-key-here
